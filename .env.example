# Optional for REST fallback. Kalshi WebSockets require the key ID and RSA key.
KALSHI_API_BASE=https://external-api.kalshi.com/trade-api/v2
KALSHI_WS_URL=wss://external-api-ws.kalshi.com/trade-api/ws/v2
KALSHI_SERIES=KXBTC15M
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=/absolute/path/to/kalshi-private-key.pem
KALSHI_MODEL_HOST=127.0.0.1
KALSHI_MODEL_PORT=8765
KALSHI_MODEL_POLL_SECONDS=5
KALSHI_MODEL_LIVE_UPDATE_SECONDS=0.1
KALSHI_MODEL_OPEN_BROWSER=1
